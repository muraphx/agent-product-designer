{
  "name": "agent-product-designer",
  "version": "0.1.0",
  "private": true,
  "description": "Agente product designer com tres portoes bloqueantes (sem AI slop, sem decisao sem estrategia, sem excessos).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-product-designer": "./install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gates": "node gates/run.mjs",
    "gates:py": "python dist/chatgpt/gates.py",
    "gates:py:self-check": "python dist/chatgpt/gates.py --self-check",
    "fixtures": "node tests/build-fixtures.mjs",
    "test": "node tests/build-fixtures.mjs && node tests/all.mjs && node tests/swap.mjs && node tests/mcp-smoke.mjs",
    "test:swap": "node tests/swap.mjs",
    "test:mcp": "node tests/mcp-smoke.mjs",
    "parity": "python dist/chatgpt/parity.py --md dist/chatgpt/PARITY.md",
    "example": "node gates/run.mjs examples/landing",
    "bench": "node bench/run-lane-a.mjs",
    "bench:quick": "node bench/run-lane-a.mjs --only=kernel,judge --out=bench/results/lane-a-quick.json",
    "bench:self-check": "node bench/lib/metrics.mjs --self-check",
    "memory": "node bin/memory-server.mjs",
    "memory:selftest": "node bin/memory-server.mjs --selftest",
    "install:claude": "node install.mjs --client claude",
    "install:hermes": "node install.mjs --client hermes",
    "install:agents": "node install.mjs --client agents",
    "install:chatgpt": "node install.mjs --client chatgpt",
    "validate": "node install.mjs --validate"
  }
}
